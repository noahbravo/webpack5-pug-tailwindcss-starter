{
  "name": "webpack5-pug-tailwindcss-starter",
  "version": "1.0.0",
  "description": "Webpack 5 configuration for Single or Multipage websites using Pug, Tailwind CSS, PostCSS, Babel and Browsersync",
  "scripts": {
    "start": "cross-env NODE_ENV=development webpack serve --mode development",
    "build": "cross-env NODE_ENV=production webpack --mode production",
    "lint": "eslint --ext .js ./src/js",
    "lint:fix": "eslint --ext .js --fix ./src/js",
    "stylelint": "stylelint ./src/css/**/*.css",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [
    "webpack",
    "webpack 5",
    "webpack multipage",
    "webpack tailwindcss",
    "webpack pug",
    "tailwindcss",
    "pug"
  ],
  "author": "Elena Bravo",
  "license": "ISC",
  "devDependencies": {
    "@babel/core": "7.29.0",
    "@babel/eslint-parser": "7.28.6",
    "@babel/plugin-proposal-class-properties": "7.18.6",
    "@babel/plugin-proposal-object-rest-spread": "7.20.7",
    "@babel/preset-env": "7.29.2",
    "autoprefixer": "10.5.0",
    "babel-eslint": "10.1.0",
    "babel-loader": "9.2.1",
    "babel-preset-env": "1.7.0",
    "browser-sync": "2.29.3",
    "browser-sync-webpack-plugin": "2.4.0",
    "bufferutil": "4.1.0",
    "copy-webpack-plugin": "11.0.0",
    "cross-env": "7.0.3",
    "css-loader": "6.11.0",
    "css-minimizer-webpack-plugin": "5.0.1",
    "eslint": "8.57.1",
    "eslint-config-prettier": "9.1.2",
    "eslint-config-standard": "17.1.0",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-node": "11.1.0",
    "eslint-plugin-prettier": "5.5.5",
    "eslint-plugin-promise": "6.6.0",
    "eslint-webpack-plugin": "4.2.0",
    "file-loader": "6.2.0",
    "html-webpack-plugin": "5.6.7",
    "husky": "8.0.3",
    "mini-css-extract-plugin": "2.10.2",
    "popper.js": "1.16.1",
    "postcss": "8.5.10",
    "postcss-loader": "7.3.4",
    "postcss-preset-env": "9.6.0",
    "prettier": "3.8.3",
    "pug": "3.0.4",
    "pug-plugin": "4.9.9",
    "raw-loader": "4.0.2",
    "replace-ext": "2.0.0",
    "stylelint": "15.11.0",
    "stylelint-config-standard": "34.0.0",
    "tailwindcss": "3.4.19",
    "terser-webpack-plugin": "5.4.0",
    "typescript": "5.9.3",
    "webpack": "5.106.2",
    "webpack-cli": "5.1.4",
    "webpack-dev-server": "4.15.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/elenabravo/webpack5-pug-tailwindcss-starter"
  },
  "husky": {
    "hooks": {
      "pre-commit": "npm run lint && npm run stylelint"
    }
  }
}
